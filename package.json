{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development node server/env-loader.cjs",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && npm run build:method-skills",
    "build:method-skills": "node -e \"const fs=require('node:fs');const destination='dist/method-skills';fs.rmSync(destination,{recursive:true,force:true});fs.cpSync('server/ai/method/skills',destination,{recursive:true})\"",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:gen": "drizzle-kit generate",
    "db:migrate:dev": "drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "test": "node -r dotenv/config node_modules/.bin/vitest",
    "test:storage": "NODE_ENV=test U4_STORAGE_TEST_DATABASE=1 node -r dotenv/config node_modules/.bin/vitest server/storage.test.ts server/storage.career-map.test.ts server/storage.migration.test.ts server/storage.performance.test.ts --run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "spike:openai": "node --env-file-if-exists=.env scripts/openai-provider-spike.mjs",
    "test:method": "npm test -- server/ai/method/loader.test.ts server/ai/method/evaluation.test.ts --run",
    "test:method-bundle": "npm run build && METHOD_PRODUCTION_SMOKE=1 npm run test:method",
    "eval:method": "node --env-file-if-exists=.env --import tsx scripts/eval-revelio-method.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/react": "^4.0.69",
    "@google/genai": "^1.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@playwright/test": "^1.54.2",
