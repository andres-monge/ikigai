# Ikigai Finder Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
# PostgreSQL connection string for your development database
DATABASE_URL=postgresql://username:password@host:port/database_name

# Google AI Studio Configuration
# API key from Google AI Studio for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifiers
# Main analysis model for high-quality reasoning and JSON output
GEMINI_REASONING_MODEL=gemini-3-flash-preview

# Gemini Model Temperature
# Controls randomness in AI responses (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=