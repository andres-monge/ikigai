# Revelio Environment Variables
# Copy this file to .env and fill in your actual values

# Application database configuration: keep this on Neon's pooled endpoint.
# Drizzle and existing application traffic use only this connection.
DATABASE_URL=postgresql://username:password@host:port/database_name

# Google AI Studio Configuration
# API key from Google AI Studio for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (optional until the agent surface is enabled)
OPENAI_API_KEY=
AGENT_ENABLED=false

# Google OAuth Configuration (optional until authentication is mounted)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Configuration
# Dedicated direct/unpooled Neon endpoint; do not use a -pooler hostname.
# Better Auth alone uses this connection with search_path=auth.
BETTER_AUTH_DATABASE_URL=postgresql://username:password@direct-host:port/database_name
# Exact local value: http://localhost:5001
# Exact production value: https://revelio-me.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5001

# Fail-closed signup switch; set to true only when public signup is intended
AUTH_SIGNUPS_ENABLED=false

# Gemini Model Identifiers
# Main analysis model for high-quality reasoning and JSON output
GEMINI_REASONING_MODEL=gemini-3-flash-preview

# Gemini Model Temperature
# Controls randomness in AI responses (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=
