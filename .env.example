# Ikigai Finder Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
# PostgreSQL connection string for your development database
DATABASE_URL=postgresql://username:password@host:port/database_name

# Google AI Studio Configuration
# API key from Google AI Studio for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifiers
# Main analysis model for high-quality reasoning and JSON output
GEMINI_REASONING_MODEL=gemini-2.5-flash

# Fact-retrieval model for cost-effective search operations
GEMINI_FACTS_MODEL=gemini-2.5-flash-lite

# YouTube Data API Configuration
# API key from Google Cloud Console with YouTube Data API v3 enabled
YOUTUBE_API_KEY=your_youtube_api_key_here